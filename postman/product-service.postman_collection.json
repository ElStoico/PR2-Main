              "pm.test('Status code es 204', function () {",
              "  pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6) Obtener producto eliminado (negativa)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrlProductos}}/productos/{{productoId}}",
          "host": [
            "{{baseUrlProductos}}"
          ],
          "path": [
            "productos",
            "{{productoId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
